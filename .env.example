# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_BASE_PATH: Optional. Base path for static hosting (e.g. GitHub Pages repo path).
# Defaults to /React-Linkpoint/ in production.
VITE_BASE_PATH="/React-Linkpoint/"

# VITE_SL_PROXY_URL: Required for browser access when the local development
# proxy is unavailable. It must point to a Linkpoint-operated proxy; public
# CORS proxies must never receive login or capability requests.
# Example: https://your-proxy.example/api/proxy?url=
VITE_SL_PROXY_URL=""

# SL_PROXY_ALLOWED_HOSTS: Comma-separated HTTPS login hosts permitted by the
# Node proxy. Capability forwarding is authorized only by a short-lived permit
# issued from a successful trusted login response.
SL_PROXY_ALLOWED_HOSTS="login.agni.lindenlab.com,login.aditi.lindenlab.com"

# Required in production. Generate a unique 32+-character secret and keep it
# on the proxy only; it signs short-lived permits for capability hosts returned
# by successful login responses.
PROXY_PERMIT_SECRET="replace-with-a-long-random-production-secret"
