{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "22.x"
  },
  "description": "Second Life communicator and viewer utility suite.",
  "author": "Linkpoint Contributors",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "node scripts/build-wasm.mjs --check && node scripts/check-source-imports.mjs && vite build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:materials": "node scripts/build-materials.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:desktop:dir": "node scripts/build-desktop.mjs --dir",
    "preview": "vite preview",
    "desktop": "electron electron/main.cjs",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:build:release": "cd android && ./gradlew assembleRelease",
    "android:bundle:release": "cd android && ./gradlew bundleRelease",
    "android:clean": "cd android && ./gradlew clean",
    "android:run": "expo run:android",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:fake-data": "node scripts/check-fake-data.mjs",
    "check:source-imports": "node scripts/check-source-imports.mjs",
    "test:live-grid": "node scripts/live-grid-smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:fake-data && npm run test && npm run build",
    "web": "expo start --web",
    "sync-design": "tsx scripts/sync-design.ts",
    "ios:pods": "cd ios && pod install",
    "postinstall": "node scripts/patch-metaverse.cjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@caspertech/node-metaverse": "^0.8.21",
    "@caspertech/llsd": "^1.0.5",
    "long": "^4.0.0",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@google/genai": "^2.24.0",
    "@linkpoint/design-system": "file:packages/design-system",
    "@noble/hashes": "^2.4.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@tailwindcss/vite": "^4.1.14",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@xmldom/xmldom": "0.9.12",
    "axios": "^1.13.6",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "expo": "~57.0.22",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "jpeg2000": "1.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "^5.9.1",
    "react-native-screens": "^4.28.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2",
    "react-syntax-highlighter": "^16.1.1",
    "sharp": "^0.34.4",
    "spark-md5": "^3.0.2",
    "tsx": "^4.23.13",
    "uuid": "^13.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/spark-md5": "^3.0.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.1"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  },
  "allowScripts": {
    "@firebase/util@1.15.3": true,
    "@google/genai@2.27.0": true,
    "electron@38.8.6": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "sharp@0.34.5": true
  }
}
