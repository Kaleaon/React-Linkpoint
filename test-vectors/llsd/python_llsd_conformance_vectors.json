    {
      "id": "array_empty",
      "category": "array",
      "description": "Empty LLSD array across XML, notation [], and binary '[' + U32(0) + ']'.",
      "xml": "<llsd><array/></llsd>",
      "notation": "[]",
      "binary_hex": "3c3f6c6c73642f62696e6172793f3e0a5b000000005d",
      "binary_has_header": true,
      "roundtrip_xml": true,
      "expected": {
        "llsd_type": "array",
        "items": []
      }
    },
    {
      "id": "array_heterogeneous_scalars",
      "category": "array",
      "description": "Heterogeneous LLSD array mixing undef, boolean, integer, real, string, uuid, and binary.",
      "xml": "<llsd><array><undef/><boolean>1</boolean><integer>-7</integer><real>2.5</real><string>alpha</string><uuid>89556747-24cb-43ed-920b-47caed15465f</uuid><binary>AQID</binary></array></llsd>",
      "notation": "[!,true,i-7,r2.5,'alpha',u89556747-24cb-43ed-920b-47caed15465f,b64\"AQID\"]",
      "binary_hex": "3c3f6c6c73642f62696e6172793f3e0a5b00000007213169fffffff97240040000000000007300000005616c706861758955674724cb43ed920b47caed15465f62000000030102035d",
      "binary_has_header": true,
      "roundtrip_xml": false,
      "expected": {
        "llsd_type": "array",
        "items": [
          {
            "llsd_type": "undef"
          },
          {
            "llsd_type": "boolean",
            "value": true
          },
          {
            "llsd_type": "integer",
            "value": -7
          },
          {
            "llsd_type": "real",
            "value": 2.5
          },
          {
            "llsd_type": "string",
            "value": "alpha"
          },
          {
            "llsd_type": "uuid",
            "value": "89556747-24cb-43ed-920b-47caed15465f"
          },
          {
            "llsd_type": "binary",
            "hex": "010203"
          }
        ]
      }
    },
    {
      "id": "map_empty",
      "category": "map",
      "description": "Empty LLSD map across XML, notation {}, and binary '{' + U32(0) + '}'.",
      "xml": "<llsd><map/></llsd>",
      "notation": "{}",
      "binary_hex": "3c3f6c6c73642f62696e6172793f3e0a7b000000007d",
      "binary_has_header": true,
      "roundtrip_xml": true,
      "expected": {
        "llsd_type": "map",
        "entries": {}
      }
    },
    {
      "id": "map_xml_escaped_keys",
      "category": "map",
      "description": "Map keys containing XML entities, spaces, and punctuation preserve exact characters.",
      "xml": "<llsd><map><key>key &amp; &lt;1&gt;</key><integer>10</integer><key>  spaced key  </key><string>ok</string></map></llsd>",
      "notation": "{'key & <1>':i10,'  spaced key  ':'ok'}",
      "binary_hex": "3c3f6c6c73642f62696e6172793f3e0a7b000000026b000000096b65792026203c313e690000000a6b0000000e2020737061636564206b6579202073000000026f6b7d",
      "binary_has_header": true,
      "roundtrip_xml": true,
      "expected": {
        "llsd_type": "map",
        "entries": {
          "key & <1>": {
            "llsd_type": "integer",
            "value": 10
          },
          "  spaced key  ": {
            "llsd_type": "string",
            "value": "ok"
          }
        }
      }
    },
    {
      "id": "map_nested_event_queue_envelope",
      "category": "map",
      "description": "Nested EventQueueGet-style LLSD map containing ack integer and events array of maps.",
      "xml": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><llsd><map><key>id</key><integer>108</integer><key>events</key><array><map><key>message</key><string>ChatterBoxInvitation</string><key>body</key><map><key>session_id</key><uuid>3c115e51-04f4-523c-9fa6-98aff1034730</uuid><key>from_group</key><boolean>true</boolean><key>timestamp</key><date>2025-02-01T00:00:00Z</date></map></map></array></map></llsd>",
      "notation": "<?llsd/notation?>\n{'id':i108,'events':[{'message':'ChatterBoxInvitation','body':{'session_id':u3c115e51-04f4-523c-9fa6-98aff1034730,'from_group':true,'timestamp':d\"2025-02-01T00:00:00Z\"}}]}",
      "binary_hex": "",
      "binary_has_header": true,
      "roundtrip_xml": false,
      "expected": {
        "llsd_type": "map",
        "entries": {
          "id": {
            "llsd_type": "integer",
            "value": 108
          },
          "events": {
            "llsd_type": "array",
            "items": [
              {
                "llsd_type": "map",
                "entries": {
                  "message": {
                    "llsd_type": "string",
                    "value": "ChatterBoxInvitation"
                  },
                  "body": {
                    "llsd_type": "map",
                    "entries": {
                      "session_id": {
                        "llsd_type": "uuid",
                        "value": "3c115e51-04f4-523c-9fa6-98aff1034730"
                      },
                      "from_group": {
                        "llsd_type": "boolean",
                        "value": true
                      },
                      "timestamp": {
                        "llsd_type": "date",
                        "epoch_ms": 1738368000000
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "malformed_vectors": [
    {
      "id": "xml_missing_llsd_root",
      "format": "xml",
      "description": "Root element other than <llsd> must be rejected.",
      "input": "<plist><integer>1</integer></plist>"
    },
    {
      "id": "xml_unknown_element_tag",
      "format": "xml",
      "description": "Unrecognized LLSD element tag inside <llsd> must raise a parse error.",
      "input": "<llsd><quaternion>0 0 0 1</quaternion></llsd>"
    },
    {
      "id": "xml_invalid_integer_text",
      "format": "xml",
      "description": "Non-numeric text inside <integer> must be rejected.",
      "input": "<llsd><integer>twelve</integer></llsd>"
    },
    {
      "id": "xml_invalid_uuid_text",
      "format": "xml",
      "description": "Malformed UUID string inside <uuid> must be rejected.",
      "input": "<llsd><uuid>not-a-valid-uuid</uuid></llsd>"
    },
    {
      "id": "xml_dangling_map_key",
      "format": "xml",
      "description": "<map> containing a <key> with no corresponding value element must be rejected.",
      "input": "<llsd><map><key>orphan</key></map></llsd>"
    },
    {
      "id": "notation_unterminated_map",
      "format": "notation",
      "description": "Notation map missing closing '}' brace must be rejected.",
      "input": "{'alpha':i1,'beta':i2"
    },
    {
      "id": "notation_sized_string_length_mismatch",
      "format": "notation",
      "description": "Sized string s(10)\"abc\" with fewer bytes than declared must be rejected.",
      "input": "s(10)\"abc\""
    },
    {
      "id": "binary_truncated_string",
      "format": "binary",
      "description": "Binary string declaring 16 bytes with only 3 bytes remaining must be rejected.",
      "input": "3c3f6c6c73642f62696e6172793f3e0a7300000010616263"
    }
  ]
}
